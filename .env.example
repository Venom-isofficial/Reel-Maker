# Server Configuration
PORT=3001
WORKSPACE_DIR=./workspace
OUTPUT_QUALITY=720p
SUBTITLE_STYLE=animated-highlight
THEME=dark

# API Keys
# Gemini API Key (Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Finnhub API Key (Financial News: https://finnhub.io/)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Pexels API Key (Stock Videos: https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here

# Optional: Whisper API Key (if using OpenAI API instead of local Whisper)
WHISPER_API_KEY=your_whisper_api_key_here

# Local AI & NVIDIA GPU Hardware Acceleration Settings
# WHISPER_DEVICE: cuda (for NVIDIA GPU) or cpu
WHISPER_DEVICE=cuda
# WHISPER_COMPUTE_TYPE: float16 (for NVIDIA GPU) or int8
WHISPER_COMPUTE_TYPE=float16
KOKORO_VOICE=am_michael
